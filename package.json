{
  "name": "dsh-update-check-plus",
  "version": "0.1.0",
  "description": "Checks GitHub for deepseek-harness updates, notifies in the conversation header, and can auto-download the latest source zipball. Adapts to the installed DeepSeek Harness desktop app.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.yml",
    "lib/index.js",
    "lib/client.js",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lhh666-6/dsh-update-check.git"
  },
  "homepage": "https://github.com/lhh666-6/dsh-update-check",
  "bugs": {
    "url": "https://github.com/lhh666-6/dsh-update-check/issues"
  },
  "author": "lhh666-6",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "update",
    "upgrade",
    "release",
    "desktop"
  ],
  "publishConfig": {
    "access": "public"
  }
}
